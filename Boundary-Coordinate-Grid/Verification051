# IKERUSIKI Verification 051
# Large-Prime Address Performance and Storage Benchmark
#
# Objective:
# Complete Verification050 by measuring:
# - Boundary Address construction time
# - serialized storage size
# - in-memory peak allocation
# - full-address collision count
# - unique prefix length
# - exact lookup time
#
# Scope:
# - prime-only fixed corpora
# - 512 / 1024 / 2048 / 4096-bit primes
# - 4 primes per bit size
# - axes 2..512
# - no general integers
#
# Important:
# This measures performance for the fixed prime corpora included here.
# It is not an exhaustive proof over every prime in each bit interval.

import csv
import json
import statistics
import time
import tracemalloc
from collections import Counter

AXES = list(range(2, 513))
PRIME_CORPORA = {512: [13106824538123260228479043342443952398345956586992795940842158995922367664590156505962103789656127868754807420370499878887844401831471712107487372356494381, 10193685168696439731245645063624891670523561930541963134460558810208562549193137622454161186927141081184109870618028853723047309751518621208226536545661757, 10621656030858960197909715625166747939315508518078138916721991090800328700953892008510326049216276648477532496481201769501379309069115224024687793712029591, 13320706079947057699604181154931242459992274567685268194257521742399393328162879152449927946525302509897615093032884927301266062436672863048499338442567547], 1024: [, , , ], 2048: [, , , ], 4096: [, , , ]}


def boundary_component(number, axis):
    residue = (number - 1) % axis
    reflected = axis - 1 - residue
    distance = min(residue, reflected)

    if residue < reflected:
        direction = 0
    elif residue > reflected:
        direction = 1
    else:
        direction = 2

    return distance, direction


def prime_address(prime):
    return tuple(
        boundary_component(prime, axis)
        for axis in AXES
    )


def earliest_unique_prefix(addresses):
    lengths = [None] * len(addresses)
    unresolved = set(range(len(addresses)))

    for prefix_length in range(1, len(AXES) + 1):
        counts = Counter(
            address[:prefix_length]
            for address in addresses
        )

        newly_unique = []

        for index in unresolved:
            if counts[addresses[index][:prefix_length]] == 1:
                lengths[index] = prefix_length
                newly_unique.append(index)

        unresolved.difference_update(newly_unique)

        if not unresolved:
            break

    return lengths, unresolved


def address_key(address):
    return "|".join(
        f"{distance}:{direction}"
        for distance, direction in address
    )


def benchmark_bit_size(bit_size, primes):
    tracemalloc.start()

    start = time.perf_counter_ns()
    addresses = [prime_address(prime) for prime in primes]
    build_ns = time.perf_counter_ns() - start

    _, peak_bytes = tracemalloc.get_traced_memory()
    tracemalloc.stop()

    full_counts = Counter(addresses)
    collision_groups = {
        address: count
        for address, count in full_counts.items()
        if count > 1
    }

    prefix_lengths, unresolved = earliest_unique_prefix(addresses)

    start = time.perf_counter_ns()
    full_index = {
        address_key(address): index
        for index, address in enumerate(addresses)
    }
    index_build_ns = time.perf_counter_ns() - start

    serialized = json.dumps(
        [
            {
                "prime_hex": hex(prime),
                "address": address,
            }
            for prime, address in zip(primes, addresses)
        ],
        separators=(",", ":"),
    ).encode("utf-8")

    lookup_times = []
    lookup_correct = []

    for index, address in enumerate(addresses):
        key = address_key(address)

        start = time.perf_counter_ns()
        found = full_index.get(key)
        elapsed = time.perf_counter_ns() - start

        lookup_times.append(elapsed)
        lookup_correct.append(found == index)

    per_prime_build_ns = build_ns / len(primes)
    per_prime_storage_bytes = len(serialized) / len(primes)

    rows = []

    for index, prime in enumerate(primes):
        rows.append({
            "bit_size": bit_size,
            "prime_index": index,
            "prime_hex_prefix": hex(prime)[:34],
            "address_axes": len(AXES),
            "axes_for_unique": prefix_lengths[index],
            "last_axis_for_unique": AXES[prefix_lengths[index] - 1],
            "lookup_correct": lookup_correct[index],
            "lookup_ns": lookup_times[index],
        })

    summary = {
        "bit_size": bit_size,
        "prime_count": len(primes),
        "address_axes": len(AXES),
        "full_address_count": len(full_counts),
        "collision_group_count": len(collision_groups),
        "colliding_prime_count": sum(collision_groups.values()),
        "all_unique": len(collision_groups) == 0 and not unresolved,
        "median_axes_for_unique": statistics.median(prefix_lengths),
        "max_axes_for_unique": max(prefix_lengths),
        "address_build_total_ms": build_ns / 1_000_000,
        "address_build_per_prime_us": per_prime_build_ns / 1_000,
        "index_build_us": index_build_ns / 1_000,
        "serialized_total_bytes": len(serialized),
        "serialized_per_prime_bytes": per_prime_storage_bytes,
        "peak_memory_bytes": peak_bytes,
        "median_lookup_us": statistics.median(lookup_times) / 1_000,
        "all_lookups_correct": all(lookup_correct),
    }

    return rows, summary


def write_csv(path, rows):
    with open(path, "w", newline="", encoding="utf-8") as file:
        writer = csv.DictWriter(
            file,
            fieldnames=list(rows[0].keys()),
        )
        writer.writeheader()
        writer.writerows(rows)


def main():
    all_rows = []
    summaries = []

    print("IKERUSIKI Verification051")
    print("Large-Prime Address Performance and Storage Benchmark")
    print()

    total_start = time.perf_counter()

    for bit_size in sorted(PRIME_CORPORA):
        rows, summary = benchmark_bit_size(
            bit_size,
            PRIME_CORPORA[bit_size],
        )

        all_rows.extend(rows)
        summaries.append(summary)

        print(
            f'{bit_size:>4}-bit | '
            f'primes={summary["prime_count"]} | '
            f'build/prime={summary["address_build_per_prime_us"]:.2f} us | '
            f'storage/prime={summary["serialized_per_prime_bytes"]:.1f} B | '
            f'peak memory={summary["peak_memory_bytes"] / 1024:.1f} KiB | '
            f'lookup={summary["median_lookup_us"]:.3f} us | '
            f'collisions={summary["collision_group_count"]} | '
            f'unique={summary["all_unique"]}'
        )

    write_csv("verification051_results.csv", all_rows)
    write_csv("verification051_summary.csv", summaries)

    print()
    print("Verification051 Summary")
    print(
        "All large-prime addresses collision-free:",
        all(summary["all_unique"] for summary in summaries),
    )
    print(
        "All exact lookups correct:",
        all(summary["all_lookups_correct"] for summary in summaries),
    )
    print(
        "Total elapsed seconds:",
        f"{time.perf_counter() - total_start:.6f}",
    )


if __name__ == "__main__":
    main()
