す# IKERUSIKI Verification 053
# Expanded Large-Prime Boundary Address Corpus 窶� Split-Data Edition
#
# Required files in the same directory:
#   prime_corpus_512.txt
#   prime_corpus_1024.txt
#   prime_corpus_2048.txt
#   prime_corpus_4096.txt
#
# Each corpus file contains one verified prime per line.
#
# This program performs:
# 1. Prime-corpus loading and bit-length validation
# 2. Boundary Address construction
# 3. Full-address collision detection
# 4. Earliest unique-prefix measurement
# 5. Exact Address lookup verification
# 6. Build time, memory, storage, and lookup measurements
# 7. CSV output
#
# This is a corpus-level verification, not an exhaustive proof over every
# prime in each complete bit interval.

import csv
import json
import math
import statistics
import time
import tracemalloc
from collections import Counter
from pathlib import Path

BIT_SIZES = [512, 1024, 2048, 4096]
AXES = list(range(2, 513))


def load_prime_corpus(bit_size):
    path = Path(__file__).with_name(
        f"prime_corpus_{bit_size}.txt"
    )

    if not path.exists():
        raise FileNotFoundError(
            f"Required corpus file not found: {path.name}"
        )

    primes = []

    for line_number, raw_line in enumerate(
        path.read_text(encoding="utf-8").splitlines(),
        start=1,
    ):
        line = raw_line.strip()

        if not line or line.startswith("#"):
            continue

        try:
            prime = int(line)
        except ValueError as error:
            raise ValueError(
                f"{path.name}:{line_number}: invalid integer"
            ) from error

        if prime.bit_length() != bit_size:
            raise ValueError(
                f"{path.name}:{line_number}: "
                f"expected {bit_size}-bit integer, "
                f"found {prime.bit_length()}-bit"
            )

        primes.append(prime)

    if not primes:
        raise ValueError(f"{path.name}: no primes loaded")

    if len(primes) != len(set(primes)):
        raise ValueError(f"{path.name}: duplicate values found")

    return primes


def boundary_component(number, axis):
    residue = (number - 1) % axis
    reflected = axis - 1 - residue
    distance = min(residue, reflected)

    if residue < reflected:
        direction = 0
    elif residue > reflected:
        direction = 1
    else:
        direction = 2

    return distance, direction


def prime_address(prime):
    return tuple(
        boundary_component(prime, axis)
        for axis in AXES
    )


def earliest_unique_prefixes(addresses):
    lengths = [None] * len(addresses)
    unresolved = set(range(len(addresses)))
    convergence = []

    for prefix_length, axis in enumerate(AXES, start=1):
        counts = Counter(
            address[:prefix_length]
            for address in addresses
        )

        newly_unique = []

        for index in unresolved:
            if counts[addresses[index][:prefix_length]] == 1:
                lengths[index] = prefix_length
                newly_unique.append(index)

        unresolved.difference_update(newly_unique)

        convergence.append(
            {
                "axis_position": prefix_length,
                "axis": axis,
                "remaining_nonunique": len(unresolved),
                "newly_unique": len(newly_unique),
                "unique_fraction": (
                    (len(addresses) - len(unresolved))
                    / len(addresses)
                ),
            }
        )

        if not unresolved:
            break

    return lengths, unresolved, convergence


def address_key(address):
    return "|".join(
        f"{distance}:{direction}"
        for distance, direction in address
    )


def benchmark_bit_size(bit_size, primes):
    tracemalloc.start()

    start = time.perf_counter_ns()
    addresses = [prime_address(prime) for prime in primes]
    address_build_ns = time.perf_counter_ns() - start

    _, peak_memory_bytes = tracemalloc.get_traced_memory()
    tracemalloc.stop()

    full_counts = Counter(addresses)
    collision_groups = {
        address: count
        for address, count in full_counts.items()
        if count > 1
    }

    prefix_lengths, unresolved, convergence = (
        earliest_unique_prefixes(addresses)
    )

    start = time.perf_counter_ns()
    exact_index = {
        address_key(address): index
        for index, address in enumerate(addresses)
    }
    index_build_ns = time.perf_counter_ns() - start

    lookup_times = []
    lookup_correct = []

    for index, address in enumerate(addresses):
        key = address_key(address)

        start = time.perf_counter_ns()
        found = exact_index.get(key)
        lookup_ns = time.perf_counter_ns() - start

        lookup_times.append(lookup_ns)
        lookup_correct.append(found == index)

    serialized = json.dumps(
        [
            {
                "prime_hex": hex(prime),
                "address": address,
            }
            for prime, address in zip(primes, addresses)
        ],
        separators=(",", ":"),
    ).encode("utf-8")

    results = []

    for index, prime in enumerate(primes):
        prefix_length = prefix_lengths[index]

        results.append(
            {
                "bit_size": bit_size,
                "prime_index": index,
                "prime_hex_prefix": hex(prime)[:34],
                "address_axes": len(AXES),
                "axes_for_unique": prefix_length,
                "last_axis_for_unique": (
                    AXES[prefix_length - 1]
                    if prefix_length is not None
                    else None
                ),
                "lookup_correct": lookup_correct[index],
                "lookup_ns": lookup_times[index],
            }
        )

    unique_lengths = [
        value
        for value in prefix_lengths
        if value is not None
    ]
    ordered = sorted(unique_lengths)
    p95_index = max(
        0,
        math.ceil(len(ordered) * 0.95) - 1,
    )

    summary = {
        "bit_size": bit_size,
        "prime_count": len(primes),
        "full_address_count": len(full_counts),
        "collision_group_count": len(collision_groups),
        "colliding_prime_count": sum(
            collision_groups.values()
        ),
        "unique_identification_rate": (
            len(unique_lengths) / len(primes)
        ),
        "unresolved_prime_count": len(unresolved),
        "median_axes_for_unique": statistics.median(
            unique_lengths
        ),
        "mean_axes_for_unique": statistics.mean(
            unique_lengths
        ),
        "p95_axes_for_unique": ordered[p95_index],
        "max_axes_for_unique": max(unique_lengths),
        "address_build_total_ms": (
            address_build_ns / 1_000_000
        ),
        "address_build_per_prime_us": (
            address_build_ns / len(primes) / 1_000
        ),
        "index_build_total_us": (
            index_build_ns / 1_000
        ),
        "serialized_total_bytes": len(serialized),
        "serialized_per_prime_bytes": (
            len(serialized) / len(primes)
        ),
        "peak_memory_bytes": peak_memory_bytes,
        "median_lookup_us": (
            statistics.median(lookup_times) / 1_000
        ),
        "all_lookups_correct": all(lookup_correct),
    }

    for row in convergence:
        row["bit_size"] = bit_size

    return results, convergence, summary


def write_csv(path, rows):
    with open(path, "w", newline="", encoding="utf-8") as file:
        writer = csv.DictWriter(
            file,
            fieldnames=list(rows[0].keys()),
        )
        writer.writeheader()
        writer.writerows(rows)


def main():
    print("IKERUSIKI Verification053")
    print("Expanded Large-Prime Boundary Address Corpus")
    print()

    total_start = time.perf_counter()
    all_results = []
    all_convergence = []
    summaries = []

    for bit_size in BIT_SIZES:
        primes = load_prime_corpus(bit_size)

        results, convergence, summary = benchmark_bit_size(
            bit_size,
            primes,
        )

        all_results.extend(results)
        all_convergence.extend(convergence)
        summaries.append(summary)

        print(
            f'{bit_size:>4}-bit | '
            f'primes={summary["prime_count"]} | '
            f'collisions={summary["collision_group_count"]} | '
            f'unique={summary["unique_identification_rate"]:.3f} | '
            f'median axes={summary["median_axes_for_unique"]} | '
            f'p95={summary["p95_axes_for_unique"]} | '
            f'max={summary["max_axes_for_unique"]} | '
            f'build/prime={summary["address_build_per_prime_us"]:.2f} us | '
            f'lookup={summary["median_lookup_us"]:.3f} us'
        )

    base = Path(__file__).resolve().parent

    write_csv(
        base / "verification053_results.csv",
        all_results,
    )
    write_csv(
        base / "verification053_convergence.csv",
        all_convergence,
    )
    write_csv(
        base / "verification053_summary.csv",
        summaries,
    )

    print()
    print("Verification053 Summary")
    print(
        "All corpora collision-free:",
        all(
            summary["collision_group_count"] == 0
            for summary in summaries
        ),
    )
    print(
        "All primes uniquely identified:",
        all(
            summary["unique_identification_rate"] == 1.0
            for summary in summaries
        ),
    )
    print(
        "All exact lookups correct:",
        all(
            summary["all_lookups_correct"]
            for summary in summaries
        ),
    )
    print(
        "Total elapsed seconds:",
        f"{time.perf_counter() - total_start:.6f}",
    )


if __name__ == "__main__":

