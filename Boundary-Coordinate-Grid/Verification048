def sieve_primes(limit):
    sieve = bytearray(b"\x01") * (limit + 1)
    sieve[0:2] = b"\x00\x00"

    for number in range(2, math.isqrt(limit) + 1):
        ふるい[番号]の場合：
            開始 = 数値 * 数値
            count = ((limit - start) // number) + 1
            sieve[start:limit + 1:number] = b"\x00" * count

    sieve[n] の場合、[n for n in range(2, limit + 1)] を返します。


